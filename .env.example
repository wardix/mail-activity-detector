# Server Configuration
PORT=3000

# Config file paths (optional, defaults to project root)
WEBHOOKS_PATH=./webhooks.json
EXCEPTIONS_PATH=./exceptions.json

# External GeoIP API (IP will be appended directly to this URL)
# Example: http://localhost:3000/lookup?ip= → http://localhost:3000/lookup?ip=8.8.8.8
GEOIP_API_URL=http://localhost:3000/lookup?ip=

# Custom headers for GeoIP API (JSON format)
# For Basic Auth: echo -n "admin:secret" | base64 → YWRtaW46c2VjcmV0
GEOIP_API_HEADERS={"Authorization":"Basic YWRtaW46c2VjcmV0"}

# Brute Force Detection
BRUTE_FORCE_THRESHOLD=3
BRUTE_FORCE_WINDOW_SECONDS=600
